@ExpenseTracker.Api_HostAddress = http://localhost:5000

# Every endpoint except health needs a Supabase access token.
# Sign in to the app, then in the browser console run:
#   (await (await import('/src/supabase.ts')).supabase.auth.getSession()).data.session.access_token
# and paste it here. It expires after about an hour.
@token = <paste access token>

GET {{ExpenseTracker.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{ExpenseTracker.Api_HostAddress}}/api/health/database
Accept: application/json

###

GET {{ExpenseTracker.Api_HostAddress}}/api/categories
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{ExpenseTracker.Api_HostAddress}}/api/expenses
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "amount": 42.50,
  "currency": "AUD",
  "expenseDate": "2026-10-18",
  "categoryId": "00000000-0000-0000-0000-000000000101",
  "merchant": "Woolworths",
  "description": "Weekly groceries"
}

###

# Replace the id with one returned by the POST above.
GET {{ExpenseTracker.Api_HostAddress}}/api/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{ExpenseTracker.Api_HostAddress}}/api/expenses?startDate=2026-10-01&endDate=2026-10-31&categoryId=00000000-0000-0000-0000-000000000101&page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

###

# Replace the id with one returned by the POST above.
PUT {{ExpenseTracker.Api_HostAddress}}/api/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "amount": 55.00,
  "currency": "AUD",
  "expenseDate": "2026-10-19",
  "categoryId": "00000000-0000-0000-0000-000000000102",
  "merchant": "Cafe",
  "description": "Lunch"
}

###

# Replace the id with one returned by the POST above.
DELETE {{ExpenseTracker.Api_HostAddress}}/api/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

GET {{ExpenseTracker.Api_HostAddress}}/api/budget
Authorization: Bearer {{token}}
Accept: application/json

###

PUT {{ExpenseTracker.Api_HostAddress}}/api/budget
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "weeklyAmount": 300.00
}

###

DELETE {{ExpenseTracker.Api_HostAddress}}/api/budget
Authorization: Bearer {{token}}

###

GET {{ExpenseTracker.Api_HostAddress}}/api/fixed-expenses
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{ExpenseTracker.Api_HostAddress}}/api/fixed-expenses
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Rent",
  "amount": 450.00,
  "currency": "AUD",
  "categoryId": "00000000-0000-0000-0000-000000000104",
  "startDate": "2026-10-01",
  "frequency": "Weekly"
}

###

# Replace the id with one returned by the POST above.
PUT {{ExpenseTracker.Api_HostAddress}}/api/fixed-expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Rent",
  "amount": 480.00,
  "currency": "AUD",
  "categoryId": "00000000-0000-0000-0000-000000000104",
  "startDate": "2026-10-01",
  "frequency": "Fortnightly"
}

###

# Replace the id with one returned by the POST above.
DELETE {{ExpenseTracker.Api_HostAddress}}/api/fixed-expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

# The Monday–Sunday week that contains the date.
GET {{ExpenseTracker.Api_HostAddress}}/api/summary/week?date=2026-10-21
Authorization: Bearer {{token}}
Accept: application/json

###

# The 12 months ending at endMonth.
GET {{ExpenseTracker.Api_HostAddress}}/api/summary/months?endMonth=2026-10
Authorization: Bearer {{token}}
Accept: application/json

###

# Reads a JPEG, PNG or WebP image (max 3 MB) and returns a draft. Nothing is saved.
# Uses the local test image, which is kept out of git; any other image path works too.
POST {{ExpenseTracker.Api_HostAddress}}/api/receipts/analyze
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: multipart/form-data; boundary=receipt

--receipt
Content-Disposition: form-data; name="file"; filename="receipt.png"
Content-Type: image/png

< ../../tests/ExpenseTracker.IntegrationTests/TestFiles/receipt.png
--receipt--

###
